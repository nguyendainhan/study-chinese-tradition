# ===============================================
# Cấu hình môi trường cho Backend Node.js / Express
# ===============================================

PORT=5000
NODE_ENV=development

# Cấu hình kết nối MySQL (Đã bật Connection Pooling & Parameterized Queries)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=formosa_study_db

# Khóa bí mật ký JWT Tokens (Tạo chuỗi ngẫu nhiên bảo mật cao)
JWT_ACCESS_SECRET=formosa_jwt_access_super_secret_key_2026_xyz!
JWT_REFRESH_SECRET=formosa_jwt_refresh_super_secret_key_long_term_2026_abc!

# Thời hạn hiệu lực của Token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cấu hình CORS (URL của ứng dụng Frontend Vite/React)
CORS_ORIGIN=http://localhost:5173

